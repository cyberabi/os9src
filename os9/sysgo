 use defsfile

*****
*
*  Coldstart Module
*
* Starts Cmd Module On Path "/Term"
*
Type set SYSTM+OBJCT
Revs set REENT+1
 mod CldEnd,CldNam,Type,Revs,CldEnt,CldMem
CldNam fcs /SysGo/

 fcb 12 Edition number

 ifeq CPUType-Color
 rmb 200
 else
 rmb 256 stack space
 endc

CldMem equ .

MOTD equ *
 fcc "OS-9 LEVEL ONE VR. 02.00.00"
 fcb $0d,$0a
 fcc "COPR. 1980 BY MOTOROLA INC. AND"
 fcb $0d,$0a
 fcc "MICROWARE SYSTEMS CORP."
 fcb $0d,$0a
 fcc "LICENSED TO TANDY CORP."
 fcb $0d,$0a
 fcc "ALL RIGHTS RESERVED."
 fcb $0d,$0a,$0a
MOTDEnd equ *

HDStr fcc "/H0"
 fcb $D
HDDir fcc "/H0/"
DirStr fcc "Cmds"
 fcb $D
 fcc ",,,,,,,,,," room for patch
CMDSTR fcc "Shell"
 fcb $D
 fcc "TSMON"
 fcb $D
SHLFUN fcc "STARTUP -P"
 fcb $D
 fcc ",,,,,,,,,," room for patch
FUNSIZ equ *-SHLFUN


 ifeq CPUType-Color
SysTime fcb 85,6,1,0,0,0 default system time
WarmVec fcb $55 sentinel
 fcb $00
 fcb $74
 nop
 clr $FF03 Vertical sync control 
 nop two bytes nop if warm start
 nop
 sta $FFDF upper 32K ram
 jmp $EF0E run boot code loaded from disk
WVEnd equ *
 endc

CldEnt equ *
 leax CLICPT,PCR Set up signal intercept
 OS9 F$ICPT

 ifeq CPUType-Color
 leax WarmVec,PCR get cold start hook ptr
 ldu #D.CBStrt Color Computer warm start
 ldb #(WVEnd-WarmVec) get length
CldEnt1 lda ,X+
 sta ,U+
 decb
 bne CldEnt1
 leax MOTD,PCR get startup msg ptr
 ldy #(MOTDEnd-MOTD) get length
 lda #1 standard out
 OS9 I$WRITE 
 leax SysTime,PCR
 OS9 F$STime
 endc

 leax DirStr,PCR Get directory name ptr
 lda #EXEC. Get execution mode
 OS9 I$ChgDir Change execution directory
* NOTE: do not test for error, at least system will boot
 ifeq CPUType-Color
 leax HDStr,PCR Try for hard disk on h0
 lda #READ.+WRITE.
 OS9 I$ChgDir
 bcs NOHD
 leax HDDir,PCR HD execution directory
 lda #EXEC. Get execution mode
 OS9 I$ChgDir
 bcc NOHD
NOHD OS9 F$ID Get proc id
 ldb #$80 use medium priority
 OS9 F$SPRIOR
 endc
 leax CMDSTR,PCR Get ptr to "shell"
 leau SHLFUN,PCR Get ptr to startup file name
 ldd #OBJCT*256 Get type
 ldy #FUNSIZ Size of parameters
 OS9 F$FORK Execute startup file
 bcs CLDERR Branch if error
 OS9 F$WAIT Wait for it
CLDM10 leax CMDSTR,PCR Get command name ptr
 ldd #OBJCT*256
 ldy #0 No parameters
 OS9 F$FORK Start new process
 bcs CLDERR
 OS9 F$WAIT Wait for it to die
 bcc CLDM10

CLDERR equ *
 ifeq CPUType-Color
 bra CLDERR
 else
 jmp [$FFFE]
 endc

CLICPT rti COLDSTART Intercept routine

 emod Module Crc

CldEnd equ *


 end
