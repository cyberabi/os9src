***************************************************************
*
* Disk Boot Module Header
*
*
 mod BTEND,BTNAM,SYSTM+OBJCT,REENT+1,BTENT,BTSTA
BTNAM fcs "Boot"

 fcb 4 Edition telltale byte
*******************
* Revision History
* edition 0: prehistoric
* edition 1: all use statements converted to use defsfile
*            copyright removed from object file
*            disktype set Dc3 added
* edition ?: backported to CoCo 2.00.00
* edition 4: backported to CoCo 2.01.00; double-sided
*******************

 pag
*********************************************************************
*
* Static Storage
*
*
 org 0
V.CMD rmb 1 Temporary save byte
 rmb 1
V.BUF rmb 2 Local buffer addr
V.TRCK rmb 1 Current track
V.FMT rmb 1 Disk format
V.TKS rmb 1 Sectors / track
V.SCT rmb 2 Sector count (unused)
V.SIDES equ V.SCT+1 Non-zero if double-sided
V.SIDE rmb 1 Side flag for LSN to (t,s)
BTSTA equ . Total static requirement


*
* FD1773 Commands
*

F.REST equ $00 Restore command (unload head, no verf, slow step)
F.SEEK equ $10 Seek command (no verf, slow step)
F.STPI equ $43 Step in one track command
F.READ equ $80 Read sector command (non-IBM)
F.WRIT equ $A0 Write sector command (non-IBM)
F.TYP1 equ $D0 Force type 1 status
F.WRTR equ $F4 Write track command

*
* Hardware Offsets from DPort
*

 org 0
DP.Ctrl rmb 1 control register
 rmb 7
DP.CmdR rmb 1 command register
DP.TrkR rmb 1 track register
DP.SecR rmb 1 sector register
DP.DatR rmb 1 data register

SeekDly set 8750 seek delay
MotorDly set 25000 disk select delay
MotorOn set %00001000 motors on
RddDrv0 set %00101001 select drive 0, DD
SelDrv0 set %00001001 select drive 0
HaltDrv0 set %10111001 enable halt on drive 0
SPT set 18

VV.NMI set $0109 NMI hook

 pag
****************************************************************
*
* Initialize The I/O Port
*
*  Input: (U)= Pointer To Global Storage
*
*  On Exit: (A) Modified
*           (X) Modified
*           (Y) Unchanged
*           (U) Unchanged
*
BTENT clra
 ldb #BTSTA Get size of needed static
INILUP pshs a
 decb
 bne INILUP
 tfr s,u Point "u" to static
 ldx #DPort+DP.CmdR Point to command register
 lda #F.Typ1
 sta ,x Inz controller chip
 lbsr Delay1 Wait for 1771
 lda ,x Read controller status to clear it.
 lda #$FF
 sta V.TRCK,U Inz to high track count
 leax READNMI,PCR hook NMI for halt
 stx VV.NMI+1
 lda #$7E jmp opcode
 sta VV.NMI+0
 lda #MotorOn turn on disk motors
 sta DPort+DP.Ctrl
 ldd #MotorDly spin up delay
SelDly nop
 nop
 subd #1
 bne SelDly

*        Fall thru to do the boot
 pag
*******************************************************************
*
* Bootstrap System From Disk
*
*         (U)= Pointer Global Storage
*
*  Output: (D)= Length Of Bootstrap Data
*          (X)= Address Of Start Of Boot Data
*          (Y) Unchanged
*          (U) Unchanged
*
LBOOT pshs D,X,Y,U Save registers
 ldd #1 Equivalent to 256 here
 OS9 F$SRqMem Get sector buffer
 bcs BOOTE1 Problem no mem
 tfr U,D Save addr
 ldu 6,S Global storage
 std V.BUF,U
 clrb
 ldx #0 Get sector 0
 bsr READSK
 bcs BOOTE1 Branch if can't
 ldd DD.TOT+1,Y Total sectors (non-HD)
 std V.SCT,U
 lda DD.FMT,Y Get disk format
 sta V.FMT,U
 anda #1 Keep sides
 sta V.SIDES,U
 lda DD.TKS,Y Get sectors / track
 sta V.TKS,U
 ldd DD.BSZ,Y Get bootstrap size
 std 0,S Return to caller
 ldx DD.BT+1,Y Get boot sector
 pshs X
 ldd #256 Return sector buffer
 ldu V.BUF,U
 OS9 F$SRtMem
 ldd 2,S Get bootstrap size
 OS9 F$SRqMem Get boot memory
 puls X Get boot sector
 bcs BOOTE1 Branch if no memory
 stu 2,S Return to caller
 ldu 6,S Get static storage
 ldd 2,S Get mem addr
 std V.BUF,U
 ldd ,S Get boot size
 beq BOOT2 no; exit
BOOT1 pshs D,X Save size, sector number
 clrb
 bsr READSK Read sector
 bcs BOOTER
 puls D,X Retrieve size, sector number
 inc V.BUF,U Move buffer ptr
 leax 1,X Up sector number
 subd #$100 Subtract page read
 bhi BOOT1 Branch if more
BOOT2 clrb CLEAR Carry
 puls d
 bra Bootz


BOOTER leas 4,S Return scratch
BOOTE1 leas 2,S Return scratch
Bootz puls x,u,y
 leas BTSTA,s De-allocate static fm stack
 rts
 pag
*********************************************************
*
* Restore Drive To Track Zero
*
*  Input: (Y)= Pointer To Path Descriptor
*         (U)= Pointer To Global Storage
*
*  If Error: (B)= Error Code & Carry Is Set
*
* Note:  We Are Stepping In Several Tracks Before
*        Issuing The Restore.  As Suggested In The
*        Application Notes.
*
RESTOR lda #RddDrv0 Control to read drive 0
 sta V.CMD,U
 clr V.TRCK,U Old track = 0
 lda #5 Repeat five times
 lbsr RESTR2 Issue command, delay & wait for done.
 ldb #F.REST Restore command
 lbra WCR0
 pag
*************************************************************
*
* Read Sector Command
*
* Input: B = Msb Of Logical Sector Number
*        X = Lsb'S Of Logical Sector Number
*        Y = Ptr To Path Descriptor
*        U = Ptr To Global Storage
*
* Output: 256 Bytes Of Data Returned In Buffer
*
* Error: Cc=Set, B=Error Code
*
READSK lda #$91 Error retry code
 cmpx #0 Is this sector zero?
 bne RDSK3 Branch if not
Read0 bsr RDSK3 Read sector into buffer
 bcs Retrn1
 ldy V.BUF,u Point "y" to dd. info
 clrb
Retrn1 rts


RDSK1 bcc RDSK3 Retry without restore
 pshs D,X
 bsr RESTOR Drive to tr00
 puls D,X
RDSK3 pshs D,X
 bsr READSC Read sector
 puls D,X
 bcc Retrn1 Return if no error
 lsra DONE?
 bne RDSK1 ...no; retry.
*
* Fall Through To Try One Last Time
*
READSC bsr PHYSIC Move head to track
 bcs Retrn1
 ldx V.BUF,u Point to buffer
 orcc #IRQMask+FIRQMask Disable interrupts
 pshs y
 ldy #-1
 ldb #F.READ Read sector command
 stb DPort+DP.CmdR
 ldb V.CMD,u
 orb #%00110000 Set DD, precomp
 tst V.SIDE,u Side 2?
 beq READSC0 ..no; skip
 orb #%01000000 Set drive select 3 (?!) for 2nd side
READSC0 stb DPort+DP.Ctrl
 lbsr DELAY1
 orb #%10000000 enable halting
 lda #%00000010 poll data request bit
READSC1 bita DPort+DP.CmdR
 bne READS2 data is ready
READSC2 leay -1,y timeout
 bne READSC1
 lda V.CMD,u
 sta DPort+DP.Ctrl
 puls y
 bra RDERR

 pag
************************************************************
*
* Read Loop
* Terminated by hardware NMI
*
READS2 lda DPort+DP.DatR Get data
 sta ,X+ Store it
 stb DPort+DP.Ctrl refresh
 bra READS2

READNMI leas 12,s
 puls y Restore regs
 ldb DPort+DP.CmdR Get status
 bitb #%00000100 Lost data?
 beq STCK

RDERR comb
 ldb #E$Read
 rts
 pag
**************************************************************
*
* Convert Logical Sector Number To Physical Track And Sector
*
*  Input:  B = Msb Of Logical Sector Number
*          X = Lsb'S Of Logical Sector Number
*  Output: A = Physical Track Number
*          Sector Reg = Physical Sector Number
*  Error:  B = Error Code, W/Carry Set
*

PHYSIC lda #SelDrv0 Control to select drive 0
 sta V.CMD,U
 clr V.SIDE,U Start on first side
 tfr X,D Logical sector (os-9)
 cmpd #0 Logical sector zero?
 beq PHYSC7 ..yes; skip conversion.
 clr ,-s Will be track number
 tst V.SIDES,U Double sided?
 beq PHYSC4 ..no; use ss code
 bra PHYSC4B ..yes; use ds code

* Double-sided conversion
PHYSC3B com V.SIDE,U Switch sides
 bne PHYSC4B ..No track yet if side 2
 inc 0,s One more track (both sides)
PHYSC4B subb V.TKS,U Subtract one track worth of sectors
 sbca #0
 bcc PHYSC3B Repeat until less than 1 trk
 bra PHYSC5

* Single-sided conversion
PHYSC3 inc 0,s One more track
PHYSC4 subb V.TKS,U Subtract one track worth of sectors
 sbca #0
 bcc PHYSC3 Repeat until less than 1 trk
PHYSC5 addb #SPT Add back for sector number (?!)
 puls A Desired track.
PHYSC7 equ *

* Fall thru to do actual seek
 pag
**************************************************************
*
* Move Head To New Track
*
* Update Track Table With
* The Current Track
*
* Load The Track Register With The
* Old Track
*
* Input:
*   A = New Track
*   B = New Sector - 1
* Output:
*   B = Contents Of FD1773 Status Reg
*   A,X = Destroyed
*

SETTRK incb sectors start at 1
 stb DPort+DP.SecR put sector in sector reg
RESTR2 ldb V.TRCK,U Get old track
 stb DPort+DP.TrkR Put old track in trk reg
 cmpa V.TRCK,U Same track?
 beq SETRK9 ..yes; skip seek.
 sta V.TRCK,U Update with new track
 sta DPort+DP.DatR Put new trk in data reg
 ldb #F.SEEK Command
 bsr WCR0 Issue command

 pshs x
 ldx #SeekDly delay for seek
SETTRK1 leax -1,x
 bne SETTRK1
 puls x

Setrk9 clrb
 rts
 pag
***********************************************************
*
* Check Status For Error Conditions
*
*  Input: (B)= Status Of FD1773
*
*  If Error: (B)= Error Code & Carry Is Set
*
*  If No Error: Carry Is Clear
*
STCK bitb #%10011000 not ready / seek error / check sum?
 bne RDERR ..yes; error
 clrb
 rts

 pag
****************************************************************
*
*
* Write Command Register
*
*
*   1 - Will Add Step Rate To Seek Commands When Wcr0 Called
*   2 - Issues Command To Controller Chip
*   3 - Will Wait For Status "Not Busy" If Wcr0 Called
*
*

WCR0 bsr DELAY delay after command
WCR02 ldb DPort+DP.CmdR Get status
 bitb #%00000001 Busy?
 bne WCR02 ..yes; wait for it.
 rts

WCR lda V.CMD,U Get preformatted command
 sta DPort+DP.Ctrl Select drive
 stb DPort+DP.CmdR Issue command
 rts

DELAY bsr WCR
DELAY1 lbsr DELAY2
DELAY2 lbsr DELAY4
DELAY4 rts

 emod

BTEND equ *

 end
