 cmpa #RAMInUse Is it in use?
 bne MAP1BLK no; store state for all pages this block
 leay (DAT.BlSz/256),Y Block's pages keep existing state
 bra NEXTBLK

ALLFREE clra Mark block's pages free (NotInUse)
* Mark all pages on block
MAP1BLK ldb #DAT.BlSz/256 Max pages on a block
MAPLOOP sta ,Y+
 decb
 bne MAPLOOP

NEXTBLK inc ,S Next block
 ldb ,S DAT index
 cmpb #DAT.BlCt Blocks left?
 bcs SRQM10 yes; continue

* Find available pages in memory map, top down
SRQM15 ldb R$A,U Get requested pages
SRQM20 cmpy D.SysMem Pages left to check?
 bhi SRQM25 yes; continue

 comb SET Carry
 ldb #E$NoRAM Err: no memory to allocate
 bra SRQMXX

SRQM25 lda ,-Y Check page
 bne SRQM15 Branch if allocated
 decb Count page number down
 bne SRQM20 Branch if not enough

* Y=pointer to free block range in system memory map
* This code relies on D.SysMem pointing to the start of a page
* This code relies on D.SysMem having fewer than 256 entries
* These two conditions mean that the low byte of Y is the starting page
 sty ,S
 lda 1,S Get block where pages start
 lsra Divide starting page by pages / block
 lsra
 lsra
 ifge (DAT.BlSz-$1000)
 lsra
 ifge (DAT.BlSz-$2000)
 lsra
 endc
 endc
 ldb 1,S Calculate number of blocks spanned
 andb #(DAT.BlSz/256)-1 Starting block on starting page
 addb R$A,U Add requested pages
 addb #(DAT.BlSz/256)-1 Round up
 lsrb Divide total pages by pages / block
 lsrb
 lsrb
 ifge (DAT.BlSz-$1000)
 lsrb
 ifge (DAT.BlSz-$2000)
 lsrb
 endc
 endc
 ldx D.SysPrc
 lbsr AIMG10 Allocate memory in image
 bcs SRQMXX
 ldb R$A,U
ALOCAT inc ,Y+ Mark block as used (RAMInUse)
 decb Count page number down
 bne ALOCAT Branch if not enough
 lda 1,S Convert page number to address
 std R$U,U Return ptr to memory
 clrb CLEAR Carry
SRQMXX leas 2,S
 rts

