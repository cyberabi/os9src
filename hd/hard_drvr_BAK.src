 nam Elektra DBI driver source code
 ttl Driver Module

 opt -c
 use defsfile

************************************************************
*
*
*
*
*       Os-9 Elektra DBI Hard Disk Driver Module Source Code
*
*        Software For Elektra DBI Hard Disk Controller
*
*                       Implemented By
*                     A. Benjamin Teifeld
*
**********************************************************************


***************************************************************
*
* Disk Driver Module Header
*
*
 mod DSKEND,DSKNAM,DRIVR+OBJCT,REENT+1,DSKENT,DSKSTA
 fcb DIR.+SHARE.+PREAD.+PWRIT.+UPDAT.+EXEC.+PEXEC.
DSKNAM fcs "DBI"

 fcb 1 Edition telltale byte
*******************
* Revision History
*
* ed. 1: First release
*
*******************

 pag
*********************************************************************
*
* Static Storage
*
*
 org DRVBEG
 rmb DRVMEM*DriveCnt
CURTBL rmb 2 Ptr to current drive tbl
CURDRV rmb 1 Drive select bit pattern
V.BUF rmb 2 Driver resident buffer addr
V.FDC rmb 6 Save area for XEBEC error status
V.FREZ rmb 1 freeze flag that prevents reading sector 0 into DD. variables
cmdbuf rmb 6 command 
cyls rmb 2 number of cylinders
heads rmb 1 number of heads/drive
reduce rmb 2 reduced write current cylinder
precom rmb 2 write precompensation cylinder
eccbst rmb 2 ECC data burst length
DSKSTA equ . Total static requirement
 pag



******************************************************************
*
* Branch Table
*
DSKENT lbra INIDSK Initialize i/o
 lbra READSK Read sector
 lbra WRTDSK Write sector
 lbra GETSTA Get status call
 lbra PUTSTA Put status call
 lbra TERMNT Terminate use of device



*
* XEBEC Commands
*
F.REST equ $01 Restore command
F.READ equ $08 Read sector command
F.WRIT equ $0A Write sector command
F.WRTR equ $06 Write track command
F.REQsns equ $03 request sense status command
F.WRTdrv equ $04 write drive (format drive) command

 pag
************************************************************
*
* Put Status Call
*
*
*
PUTSTA ldx PD.RGS,Y Point to parameters
 ldb R$B,X Get stat call
 cmpb #SS.Reset Restore call?
 lbeq RESTOR ..yes; do it.
 cmpb #SS.WTrk Write track call?
 lbeq WRTTRK ..yes; do it.
 cmpb #SS.FRZ freeze DD. info?
 beq setfrz
GETSTA comb ...NO; Error
 ldb #E$UnkSvc Error code
 rts

setfrz ldb #$FF
          stb       V.FREZ,u
          clrb
          rts
****************************************************************
*
* Initialize The I/O Port
*
*  Input: (U)= Pointer To Global Storage
*
*  On Exit: (A) Destroyed
*           (X) Destroyed
*           (Y) Destroyed
*           (U) Unchanged
*
INIDSK ldx V.PORT,U Point to i/o port
          lda       #$80      get reset code for DBI
          sta       0,x       store it in the DBI control register
 lda #$FF
 ldb #DriveCnt
 stb V.NDRV,U Inz number of drives
 leax DRVBEG,U Point to first drive table
INILUP sta DD.TOT+2,X Inz to non-zero
 sta V.TRAK,X Inz to high track count
 leax DRVMEM,X Point to next table
 decb DONE?
 bne INILUP ...no; inz more.
 ldd #256 'd' passes memory req size
 pshs U
 OS9 F$SRqMem Request 1 page of memory
 tfr U,X
 puls U
 bcs RETRN1
 stx V.BUF,U Save it for use
          ldx       V.PORT,u
          lda       1,x       read data register to clear any pending interrupt
          tfr       x,d       passes polling address
 leax FLPTBL,PCR X passes pointer to flip mask table
 leay REQSVC,PCR Y passes service routine address
 OS9 F$IRQ Put me on poll list
 bcs RETRN1 Oops no good!
 clrb
RETRN1 rts


FLPTBL fcb 0 Flip no bits
 fcb %10000000 Test bit-7 for intrpt
 fcb 1 low priority

 pag
*********************************************************
*
* Restore Drive To Track Zero
*
*  Input: (Y)= Pointer To Path Descriptor
*         (U)= Pointer To Global Storage
*
*  If Error: (B)= Error Code & Carry Is Set
*
*
RESTOR lbsr drvinit setup drive parameters
 lda #F.REST Restore command
          sta       cmdbuf,u
 lbra comrw
 pag
***************************************************************
*
* Read and Write Sector Commands
*
* Input:
*   B = Msb Of Logical Sector Number
*   X = Lsb'S Of Logical Sector Number
*   Y = Ptr To Path Descriptor
*   U = Ptr To Global Storage
*
*
* Error:
*   Carry Set
*   B = Error Code
*
READDSK lda #F.READ
          cmpx      #0        logical sector 0?
          bne       cont      not at this point, it isn't
          tstb                what about the msb?
          lbeq      READ0     if it's zero, then we need to get sector 0 in a special way
cont      bra       comrw
WRTDSK    lda       #F.WRIT
comrw     lbsr      drvinit   setup for the kind of drive we've got
          sta       cmdbuf,u  save the command
          lda       PD.DRV,u  get the drive number
          anda      #%00000001          mask out to get lsb only
          andb      #%00011111          mask out to get ms part of lsn and assume drive 0
          lsra                stick lsb of drive number into the carry for a test
          bcc       dr0       drive 0 if clear
          orb       #%00100000          otherwise set up for drive 1
dr0       andb      #%00111111          make sure only proper bits are setup
          stb       cmdbuf+1,u          save out high address and drive number
          stx       cmdbuf+2,u          save out middle and low address
          lda       #1        we only read or write one block at a time
          sta       cmdbuf+4,u
execute   lbsr      docmd     execute the command
errhan    beq       noerr
          cmpa      #$11      XEBEC CRC error?
          bne       e1
          ldb       #E$CRC    return the os9 CRC error code
          bra       errxit
e1        cmpa      #4        XEBEC drive not ready error?
          bne       e2
          ldb       #E$NotRdy return the os9 'not ready' error code
          bra       errxit
e2        adda      #128      add 128 to generate our own error codes
errxit    tfr       a,b       put our error code where os9 wants it
          orcc      #1        set the carry to indicate the error
noerr     rts

*******************************************************************************
*
* Write track
*
* input:  X -> register stack ---------- PD.RGS,y
*         Y -> path descriptor           R$X -> buffer
*         U -> static storage            R$Y  = side/dens this track
*                                        R$U  = track number
*
WRTTRK    ldd       R$U,x     get the track number
          bne       ignoreit  ignore any track other than track 0
          lbsr      drvinit   setup the parameters for this drive
          lda       #F.WRTR   get write track command
          sta       cmdbuf,u
 pag
****************************************************************
*
* Read Logical Sector Zero
*
*
*
READ0 lbsr comrw Read sector
 bcs WCR09
 ldx PD.BUF,Y
 pshs X,Y
 tst V.FREZ,u Skip copy of dd. info?
 bne READ04 Yes; ....make quick exit.
 ldy CURTBL,U
 ldb #DD.SIZ-1
READ01 lda B,X
 sta B,Y
 decb
 bpl READ01
READ04 clr V.FREZ,u Insure only one freeze
 clrb
 puls X,Y,PC


 pag
********************************************************************************
*
* irq service routine
          ldx       V.PORT,u
          clr       0,x       disable interrupts and dma
          lda       1,x       get first status byte
          ldb       V.WAKE,u  device busy?
          beq       RETRN8
waitrq    ldb       0,x       get status register
          bpl       waitrq    if msb not set, second status byte has not appeared
          ldb       1,x       get the second status byte and effectively throw it away
 clr V.WAKE,U
 sta V.FDC,U store the first error status byte for the error checking
 ldb #S$WAKE
 OS9 F$Send
 clrb
RETRN8 rts
 pag
 pag
**************************************
*
* Terminate use of the disk
*
*
*    Return Local memory to the system
*    and assure that no intrpts will occur.
*

TERMNT ldx #0
 OS9 F$IRQ Remove device from polling table
 ldu V.BUF,u Point to memory for return
 ldd #256
 OS9 F$SRtMem Return local buffer to free mem
 lda [V.CMDR,u] Remove any fdc interrupt
 rts

 emod

DSKEND equ *

 end
