00030                             ttl   OS9 Timesharing terminal monitor
TSMon                                        page   2
00032                    *****
00033                    * Tsmon [<pathname>]
00034                    *
00035                    * Timesharing monitor utility.
00036                    * Author: Robert Doggett
00037                    
00038                    * Wait for activity (Cr) on Std Input,
00039                    * then Forks to Login for user verification.
00040                    * If a pathname is specified, it is opened
00041                    * for update, and used as Std Input, Std Output
00042                    * and Std Error.
00043                    
00044    0000 87CD0081            mod   TSMEND,TSMNAM,PRGRM+OBJCT,REENT+1,TSMON,
00045    000D 54736D6F   TSMNAM   fcs   "Tsmon"
00046                    
00047    0012 08                  fcb   8          edition number
00048                    *********************
00049                    * Edition History
00050                    *
00051                    * Ed  4 - Beginning of history
00052                    *
00053                    * Ed  5 - file downcased and translated to new defs  WG
00054                    *
00055                    * Ed  6 - changed loc of buffer for readline to stack  
00056                    *
00057                    * Ed  7 - backported to CC 2.00.00 CJB  12/23/19
00058                    *
00059                    * Ed  8 - backported to CC 2.01.00 CJB  12/31/19
00060                    
00061  D 0000                     org   0
00062  D 0000            TSPROC   rmb   1          Child process id
00063  D 0001            LINPTR   rmb   2          Command line pointer
00064  D 0003            LINLEN   rmb   2          Command line length
00065  D 0005            INBUFF   equ   .          Command line buffer
00066  D 0005                     rmb   250        Stack space
00067  D 00FF                     rmb   201        room for params
00068  D 01C8            TSMMEM   equ   .
00069                    



