TSMON - OS9 Timesharing terminal monitor

00070    0013 4C4F4749   LOGIN    fcc   "LOGIN"
00071    0018 0D         TSMEOL   fcb   C$CR
00072    0019 3B         TSMRTI   rti   
00073                    
00074                    **********
00075                    * Tsmon
00076                    *   Follow Activity On Input Port
00077    001A 9F01       TSMON    stx   LINPTR     Save command line ptr
00078    001C DD03                std   LINLEN     Save command line length
00079    001E 308CF8              leax  <TSMRTI,PCR
00080    0021 103F09              os9   F$ICPT     set up dummy intercept
00081    0024 9E01       TSMON2   ldx   LINPTR     Get command line pointer
00082    0026 DC03                ldd   LINLEN     And length
00083    0028 10830002            cmpd  #2         null parameter?
00084    002C 2524                blo   TSMON6     ..no; use parent's std i/o
00085    002E A684                lda   0,X        parameter given?
00086    0030 810D                cmpa  #C$CR
00087    0032 271E                beq   TSMON6     ..no; use parent's std i/o
00088    0034 4F                  clra  
00089    0035 103F8F              os9   I$Close    close std input
00090    0038 8603                lda   #UPDAT.
00091    003A 103F84              os9   I$OPEN     Open new std input
00092    003D 253C                bcs   TSEXIT
00093    003F 4C                  inca  
00094    0040 103F8F              os9   I$Close    close std output
00095    0043 4C                  inca  
00096    0044 103F8F              os9   I$Close    close std error
00097    0047 4F                  clra             std in
00098    0048 103F82              os9   I$DUP      Dup  new std in
00099    004B 252E                bcs   TSEXIT
00100    004D 103F82              os9   I$DUP      Dup  new std out
00101    0050 2529                bcs   TSEXIT
00102                    
00103    0052 4F         TSMON6   clra  
00104    0053 3045                leax  INBUFF,U
00105    0055 108E0001            ldy   #1
00106    0059 103F8B              os9   I$ReadLn   wait for terminal activity
00107    005C 25C6                bcs   TSMON2     ..restart if error
00108    005E 8601                lda   #OBJCT
00109    0060 5F                  clrb  
00110    0061 308CAF              leax  <LOGIN,PCR
00111    0064 338CB1              leau  <TSMEOL,PCR
00112    0067 108E0000            ldy   #0
00113    006B 103F03              os9   F$FORK     start login
00114    006E 25B4                bcs   TSMON2     Error; restart
00115    0070 9700                sta   TSPROC     save process id
00116    0072 103F04     TSMON8   os9   F$WAIT     Wait for death
00117    0075 9100                cmpa  TSPROC     Child go away?
00118    0077 26F9                bne   TSMON8
00119    0079 20A9                bra   TSMON2     ..restart 
00120    007B 103F06     TSEXIT   os9   F$EXIT     Error exit
