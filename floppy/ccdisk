 opt l
 nam Color Computer FD-501 disk driver source

 opt -c

 use defsfile

 ttl Driver Module
 pag
*******************************************************************
*
*                Microware Systems Corporation
*
*
*          OS-9 Floppy Disk Driver Module Source Code
*
*      Software For Color Computer FD-502 Disk Controller
*
*                        Revised By
*                     William G. Phelps
*            Christopher J. Burke (from DC3 Driver)
*
*
*      This Controller Uses The FD1771 LSI Disk Controller
*
**********************************************************************






***************************************************************
*
* Disk Driver Module Header
*
*
 mod DSKEND,DSKNAM,DRIVR+OBJCT,REENT+1,DSKENT,DSKSTA
 fcb DIR.+SHARE.+PREAD.+PWRIT.+UPDAT.+EXEC.+PEXEC.
DSKNAM fcs "CCDisk"

 fcb 2 Edition telltale byte
*******************
* Revision History
* edition 1: prehistoric
* edition 2: backported from GIMIX DC3 driver            CJB
*******************

 pag
*********************************************************************
*
* Static Storage
*
*
 org DRVBEG
 rmb Drvmem*DriveCnt

CURTBL rmb 2 Ptr to current drive tbl
CURDRV rmb 1 Drive select bit pattern
V.DOSK rmb 1 Force seek flag
V.BUF rmb 2 Local buffer addr
DSKSTA equ . Total static requirement



******************************************************************
*
* Branch Table
*
DSKENT lbra INIDSK Initialize i/o
 lbra READSK Read sector
 lbra WRTDSK Write sector
 lbra Getsta Get status call
 lbra PUTSTA
 lbra Termnt Terminate device use



*
* Fd1771 Commands
*
F.REST equ $03 Restore command
F.SEEK equ $13 Seek command
F.STPI equ $43 Step in one track command
F.READ equ $80 Read sector command
F.WRIT equ $A0 Write sector command
F.TYP1 equ $D0 Force type 1 status
F.WRTR equ $F0 Write track command

*
* Hardware Offsets from DPort
*

 org 0
DP.Ctrl rmb 1 control register
 rmb 7
DP.CmdR rmb 1 command register
DP.TrkR rmb 1 track register
DP.SecR rmb 1 sector register
DP.DatR rmb 1 data register

SeekDly set 8750 seek delay
MotorDly set 40960 disk select delay
AtSpeed set 240 disk timer value

MotorOn set %00001000 motors on
PrecOn set %00010000 precomp on
DDMtrOn set %00101000 DD, motors on
RddDrv0 set %00111001 select drive 0, DD, precomp
SelDrv0 set %00001001 select drive 0
HltDDMtr set %10101000 enable halt, DD, motors on
HaltDrv0 set %10111001 enable halt on drive 0

Precomp set 21 write precomp start

VV.NMI set $0109 NMI hook

 pag
****************************************************************
*
* Initialize The I/O Port
*
*  Input: (U)= Pointer To Global Storage
*
*  On Exit: (A) Modified
*           (X) Modified
*           (Y) Unchanged
*           (U) Unchanged
*
INIDSK clra Haven't spun up motors yet
 sta >D.DskTmr
 ldx #DPort Point to i/o port
 leax DP.CmdR,X Point to command register
 lda #F.TYP1
 sta ,X Force Type 1 status
 lbsr DELAY1
 lda ,X Clear status
 lda #$FF
 ldb #DriveCnt
 leax DRVBEG,U Point to first drive table
INILUP sta DD.TOT,X Inz to non-zero
 sta V.TRAK,X Inz to high track count
 leax DRVMEM,X Point to next drive table
 decb DONE
 bne INILUP ...no; inz more.
 leax HALTNMI,PCR hook NMI for halt
 stx VV.NMI+1
 lda #$7E JMP opcode
 sta VV.NMI+0
 ldd #256 "d" passes memory req size
 pshs U Save "u" we need it later
 OS9 F$SRqMem Request 1 pag of mem
 tfr U,X
 puls U
 bcs RETRN1 ..oh ..oh; no mem available
 stx V.BUF,U Save for future use
 clrb
RETRN1 rts

 pag
************************************************************
*
* Stubs
*
* Get Status Call
* Terminate use of the disk (Note: leaks memory)
*
*
*
Getsta equ *
Termnt equ *
 clrb No error
 rts

 pag
*************************************************************
*
* Read Sector Command
*
* Input: B = Msb Of Logical Sector Number
*        X = Lsb'S Of Logical Sector Number
*        Y = Ptr To Path Descriptor
*        U = Ptr To Global Storage
*
* Output: 256 Bytes Of Data Returned In Buffer
*
* Error: Cc=Set, B=Error Code
*
READSK lda #$91 Error retry code
 cmpx #0 Is this sector zero?
 bne RDDSK3 Branch if not

READ0 bsr RDDSK3 Read sector zero
 bcs READ09
 ldx PD.BUF,Y
 pshs X,Y
 ldy CURTBL,U
 ldb #DD.SIZ-1
READ01 lda B,X
 sta B,Y
 decb
 bpl READ01
READ05 clrb
 puls X,Y,PC
READ09 rts

RDDSK1 bcc RDDSK3 Retry without restore
 pshs D,X
 lbsr RESTOR Drive to tr00
 puls D,X
RDDSK3 pshs D,X
 bsr READSC Read sector
 puls D,X
 bcc READ09 Return if no error
 lsra DONE?
 bne RDDSK1 ...no; retry.
*
* Fall Through To Try One Last Time
*
READSC lbsr PHYSIC Move head to track
 bcs READ09
 ldx PD.BUF,Y Point to buffer
 pshs Y,CC Save irq mask info
 orcc #IRQMask+FIRQMask Disable interrupts
 ldy #$FFFF Max delay
 ldb #F.READ Read sector command
 stb DPort+DP.CmdR Send command
 ldb #DDMtrOn Double dns w/ motor on
 orb CURDRV,U Selected drive
 stb DPort+DP.Ctrl Set control
 ldb #HltDDMtr Enable HALT
 orb CURDRV,U Selected drive
 lbsr DELAY1
 lda #%00000010 Data request bit
READS1 bita DPort+DP.CmdR Ready?
 bne READS2 ..yes; continue
 leay -1,Y
 bne READS1
 lda CURDRV,U Selected drive
 ora #MotorOn Motors stay on
 sta DPort+DP.Ctrl
 puls Y,CC
 lbra ERREAD Timeout

 pag
************************************************************
*
* Read Loop - Terminated by NMI
*
READS2 lda DPort+DP.DatR Get data
 sta ,X+ Store it
 stb DPort+DP.Ctrl Refresh control
 bra READS2

 pag
***************************************************************
*
* Write Sector Command
*
* Input:
*   B = Msb Of Logical Sector Number
*   X = Lsb'S Of Logical Sector Number
*   Y = Ptr To Path Descriptor
*   U = Ptr To Global Storage
*
*
* Error:
*   Carry Set
*   B = Error Code
*
WRTDSK lda #$91 Error retry code
WRTDS1 pshs D,X Save regs
 bsr WRITSC Write sector
 puls D,X Restore regs
 bcs WRTDS3 Write error; try again.
 tst PD.VFY,Y Verify desired?
 bne WRTDS9 ...no; all is well.
 lbsr Wrtvfy Go verify sector
 bcs WRTDS3 Error; ...retry
WRTDS9 clrb No error
 rts
WRTDS3 lsra
 lbeq ERWRITE Retries done; ...exit
 bcc WRTDS1 Retry without restore
 pshs D,X
 lbsr RESTOR Restore drive
 puls D,X
 bra WRTDS1 Retry after restore

WRITSC lbsr PHYSIC
 lbcs READ09
 ldx PD.BUF,Y Buffer addr
 ldb #F.WRIT Write function code

WRITS1 pshs Y,CC Save irq mask info
 orcc #IRQMask+FIRQMask Disable interrupts
 ldy #$FFFF Max delay
 stb DPort+DP.CmdR Send command
 ldb #DDMtrOn Double dns w/ motor on
 orb CURDRV,U Selected drive
 stb DPort+DP.Ctrl Set control
 ldb #HltDDMtr Enable HALT
 orb CURDRV,U Selected drive
 lbsr DELAY1
 lda #%00000010 Data request bit
WRITS2 bita DPort+DP.CmdR Ready?
 bne WRITE3 ..yes; continue
 leay -1,Y
 bne WRITS2
 lda CURDRV,U Selected drive
 ora #MotorOn Motors stay on
 sta DPort+DP.Ctrl
 puls Y,CC
 lbra ERWRITE Timeout

 pag
**************************************************************
*
* Write Loop - Terminated by NMI
*
WRITE3 lda ,X+ Get data
 sta DPort+DP.DatR Write it
 stb DPort+DP.Ctrl Refresh control
 bra WRITE3

 pag
***************************************************************
*
* NMI Handler
*
* Terminates read or write when all data handled
HALTNMI leas 12,s
 puls CC,Y Restore regs
 ldb DPort+DP.CmdR Get status
 bitb #%00000100 Lost data?
 lbne ERREAD
 lbra STCK

 pag
*********************************************
*
* Write Verify Routine
*
*
*    Reads back the sector just written
*    Returns carry set if bad sector
*    Compares 'read' data to 'write' data
*    Returns carry set if no compare
*  Note: Only 2 bytes out of every 8 is compared
*        assuming that any other error will cause
*        a bad Crc.

WRTVFY pshs D,X
 ldx PD.BUF,Y Save present buffer addr
 pshs X On stack
 ldx V.BUF,U Point to local buffer
 stx PD.BUF,Y
 ldx 4,S Restore (x)
 lbsr READSC
 puls X
 stx PD.BUF,Y Restore buffer pointer
 bcs WRTVF6 Error; ...try again
 lda #32 Test 32 places in buffer
 pshs a,y,u
 ldy V.BUF,u Point "y" to local buffer
 tfr x,u
WRTCHK ldx 0,u Get two bytes
 cmpx 0,y Check with 'read data'
 bne WRTVF2 Error; ...return carry set
 leau 8,u
 leay 8,y Bump both pointers
 dec 0,s Done yet?
 bne WRTCHK No; ....keep checking
 bra WRTVF4
WRTVF2 orcc #%00000001 Set carry
WRTVF4 puls a,y,u
WRTVF6 puls d,x,pc

 pag
**************************************************************
*
* Convert Logical Sector Number
* To Physical Track And Sector
*
*  Input:  B = Msb Of Logical Sector Number
*          X = Lsb'S Of Logical Sector Number
*  Output: A = Physical Track Number
*          Sector Reg = Physical Sector Number
*          Disk controller programmed with track and sector
*  Error:  Carry Set & B = Error Code
*
PHYSIC clr V.DOSK,U Default to poss skip seek
 bsr SELECT Select the specified drive
 tstb CHECK Sector bounds
 bne PHYERR  msb must be zero
 tfr X,D Logical sector (os-9)
 ldx CURTBL,U
 cmpd #0 Logical sector zero?
 beq PHYSC7 ..yes; skip conversion.
 cmpd DD.TOT+1,X Too high sector number?
 bcs PHYSC1 ..no; continue
PHYERR comb
 ldb #E$SECT Error: bad sector number
 rts
PHYSC1 clr ,-S Will be track number
 bra PHYSC3
PHYSC2 inc 0,S Another track
PHYSC3 subd #18 Subtract one track worth of sectors
 bcc PHYSC2 Repeat until less than 1 track size
 addb #18 Add back for sector number
 puls A Desired track.
 cmpa #Precomp Precomp?
 bls PHYSC7
 pshs A Save track
 lda CURDRV,U
 ora #PrecOn Enable precomp
 sta CURDRV,U
 puls A Desired track
PHYSC7 incb Adjust for 1-based sector
 stb DPort+DP.SecR Put sector (b) in sector reg
SETTRACK ldb V.TRAK,X Current track
 stb DPort+DP.TrkR Put track (b) in track reg
 tst V.DOSK,U Force seek?
 bne SETRK6 ..yes; do it.
 cmpa V.TRAK,X Same track?
 beq SETRK8 ..yes; skip seek
SETRK6 sta V.TRAK,X 
 sta DPort+DP.DatR Put new trk in data reg
 ldb #F.SEEK Command
 bsr WCR01 Issue command
 pshs X
 ldx #SeekDly Delay for seek
SETRK7 leax -1,X
 bne SETRK7
 puls X
SETRK8 clrb
RETRN2 rts

 pag
***************************************************************
*
* Select Drive
*
*  Input: (U)= Pointer To Global Storage
*
* Output: Curtbl,U=Current Drive Tbl
*         Curdrv,U=Drive Number
*

* Table of drive number to drive select bit pattern
SELTBL fcb %00000001,%00000010,%00000100,%01000000

SELECT lbsr MOTOR
 lda PD.DRV,Y Get drive number
 cmpa #4 Drive num ok?
 bcs SLCT1
ERUNIT comb
 ldb #E$UNIT Error: illegal unit (drive)
 rts
SLCT1 pshs X,D
 leax SELTBL,PCR
 ldb A,X Drive number to select bit
 stb CURDRV,U
 leax DRVBEG,U Start of drive tables
 ldb #DRVMEM
 mul OFFSET For this drive
 leax D,X
 cmpx CURTBL,U New device call?
 beq SELCT5 ...no; don't force seek
 stx CURTBL,U Current table ptr
 com V.DOSK,U Set force seek flag
SELCT5 puls D,X,PC Return (carry clear)

 pag
***********************************************************
*
* Check Status For Error Conditions
*
*  Input: (B)= Status Of Fd1771
*
*  If Error: (B)= Error Code & Carry Is Set
*
*  If No Error: Carry Is Clear
*
STCK bitb #%11111000 Any possible error bits set?
 beq STCK9 ..no; exit
 bitb #%10000000 Drive ready?
 bne ERNRDY ..no; error
 bitb #%01000000 Write protect?
 bne ERWP ..yes; error
 bitb #%00100000 Bad data address mark?
 bne ERWRITE ..yes; error
 bitb #%00010000 Seek error?
 bne ERSEEK ..yes; return error
 bitb #%00001000 Check sum ok?
 bne ERRCRC ..no; return error
STCK9 clrb No problem
 rts

ERNRDY comb
 ldb #E$NotRdy Error: drive not ready
 rts

ERWP comb
 ldb #E$WP Error: write protect
 rts

ERWRITE comb
 ldb #E$Write Error: data address mark
 rts

ERSEEK comb
 ldb #E$SEEK Error: seek error
 rts

ERRCRC comb
 ldb #E$CRC Error: bad check sum
 rts

ERREAD comb
 ldb #E$Read Error: read error
 rts

 pag
****************************************************************
*
*
* Write Command Register
*
*   1 - Issues Command To Controller Chip
*   2 - Will Wait For Status "Not Busy" If Wcr0 Called
*
*
WCR01 bsr Delay Issue command & delay
WCR02 ldb DPort+DP.CmdR Get status
 bitb #%00000001 Busy?
 beq DELAY4 ..no; do nothing
 lda #AtSpeed Flag motors at speed
 sta >D.DskTmr
 bra WCR02 wait for it

WCR lda #MotorOn Motors on
 ora CURDRV,U Drive select mask
 sta DPort+DP.Ctrl Select drive
 stb Dport+DP.CmdR Issue command
 rts

DELAY bsr WCR
DELAY1 lbsr DELAY2
DELAY2 lbsr DELAY4
DELAY4 rts

 pag
************************************************************
*
* Put Status Call
*
*
*
PUTSTA ldx PD.RGS,Y Point to parameters
 ldb R$B,X Get stat call
 cmpb #SS.Reset Restore call?
 beq RESTOR ..yes; do it.
 cmpb #SS.WTrk Write track call?
 beq WRTTRK ..yes; do it.
 comb ...NO; Error
 ldb #E$UnkSvc Error code
PUTSTA9 rts

 pag
*****************************************************************
*
* Write Full Track
*  Input: (A)=Track
*         (Y)=Path Descriptor
*         (U)=Global Storage
*
WRTTRK lbsr SELECT Select drive
 lda R$U+1,X Track number
 cmpa #Precomp
 bls WRTRK1
 ldb CURDRV,U Turn on precomp
 orb #PrecOn
 stb CURDRV,U
WRTRK1 ldx Curtbl,u Point to drive table
 lbsr SETTRACK Seek to track
 bcs PUTSTA9
 ldx PD.RGS,Y
 ldx R$X,X Get buffer addr
 ldb #F.WRTR
 lbra WRITS1

 pag
*********************************************************
*
* Restore Drive To Track Zero
*
*  Input: (Y)= Pointer To Path Descriptor
*         (U)= Pointer To Global Storage
*
*  If Error: (B)= Error Code & Carry Is Set
*
* Note:  We Are Stepping In Several Tracks Before
*        Issuing The Restore.  As Suggested In The
*        Application Notes.
*
RESTOR lbsr SELECT Select drive
 ldx CURTBL,U
 clr V.TRAK,X Old track = 0
 lda #5 Repeat five times
RESTR2 ldb #F.STPI Step in command
 pshs A
 lbsr WCR01 Issue command, delay & wait for done.
 puls A
 deca DONE Stepping?
 bne RESTR2 ...no; step again.
 ldb #F.REST Restore command
 bra WCR01

 pag
*********************************************************
*
* Motor timer
*
MOTOR pshs D,X
 lda >D.DskTmr Motors at speed?
 bne MOTOR9 ..yes; skip delay
 lda #MotorOn turn on disk motors
 sta DPort+DP.Ctrl
 ldx #MotorDly spin up delay
SelDly nop
 nop
 leax -1,X
 bne SelDly
MOTOR9 lda #AtSpeed Flag motors at speed
 sta >D.DskTmr
 puls D,X,PC


 emod
DSKEND equ *

 end
